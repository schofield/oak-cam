<?xml version="1.0" encoding="UTF-8"?>
<!--
  Base entitlements for oak-cam.app (hardened runtime). Camera access lets
  CMIOStreamCopyBufferQueue hand back the extension's sink queue under the
  hardened runtime. With a provisioning profile, build-macos.sh adds
  com.apple.developer.system-extension.install and the team app group
  TEAMID.com.surlysoft.oak-cam (the group the camera extension declares), as
  stream-concern's bundle script does: AMFI kills any app that carries the
  restricted install entitlement without an embedded profile granting it.
  Keep this plist minimal: no XML DOCTYPE, no double hyphen inside comments.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
